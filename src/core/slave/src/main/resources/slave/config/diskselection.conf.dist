############################
## DiskSelection Settings ##
####################################################################################################
#                                                                                                  #
# This Chain of filters help you to keep your roots organized.                                     #
# WARN: This filters MUST work in a synchronized way with SlaveSelection.                          #
#                                                                                                  #
# Simple filter combined w/ the 'assign=all' property.                                             #
# The 'assign=all' property saves the admin sometime as it automatically                           #
#  adds the existing roots to the ScoreChart chain.                                                #
# x.filter=minfreespace                                                                            #
# x.minfreespace=5GB                                                                               #
# x.assign=all                                                                                     #
# x.multiplier=1                                                                                   #
#                                                                                                  #
# If there's a tie on the ScoreChart, Cycle adds a point to the most unused root.                  #
# Should always be last filter on the Chain.                                                       #
# This filter does not requires a 'assign=' property.                                              #
# x.filter=cycle                                                                                   #
#                                                                                                  #
# If you have multiple roots and you want to assign a separate filter to them, use as following:   #
# x.filter=minfreespace                                                                            #
# x.minfreespace=5GB                                                                               #
# x.assign=2                                                                                       #
# x.multiplier=1                                                                                   #
#                                                                                                  #
# Matchdir(Glob)/MatchdirEx(Regex) is used to distribute certain files to certain roots.           #
# Always remember that ".match=" is a valid path according to master VFS.                          #
# So it does not work like, /mnt/site*.                                                            #
# Using the 'assign=all' property here makes the filter useless.                                   #
# x.filter=matchdir                                                                                #
# x.match=/PHOTOS*                                                                                 #
# x.assign=1+100 2+remove                                                                          #
# x.assume.remove=false (if true removes all roots not mentioned in assign).                       #
# x.negate.expression=false (if true negates match).                                               #
#                                                                                                  #
# x.filter=matchdirex                                                                              #
# x.match=^/VIDEOS.*                                                                               #
# x.assign=1+remove 2+100                                                                          #
# x.assume.remove=false (if true removes all roots not mentioned in assign).                       #
# x.negate.expression=false (if true negates match).                                               #
#                                                                                                  #
# Randomspread filter grabs a random root and adds 1 (one) point                                   #
#  to it on the ScoreChart. Usefull to make files spread all over.                                 #
# This filter does not requires a 'assign=' property.                                              #
# x.filter=randomspread                                                                            #
#                                                                                                  #
# This filter might look foolish, but it just have the hole                                        #
#  of letting you choose which root will be filled first.                                          #
# Using this filter (depeding on the way, of course) you prolly                                    #
#  make 'randomspread' and 'cycle' useless.                                                        #
# Using the 'assign=all' property here makes the filter useless.                                   #
# x.filter=priority                                                                                #
# x.assign=1+100 2+200                                                                             #
#                                                                                                  #
####################################################################################################

# minfreespace is measured per physical root, not against the slave's total free space.
# multiplier=1 penalizes the score below the minimum; it DOES NOT block uploads.
# multiplier=0 (or remove) excludes that root AT OR BELOW the minimum.
# The master reports FULL (minfreespace) when every root has a configured minimum
# and every root is at or below it. Unconfigured roots prevent a whole-slave minimum warning.
# Warnings do not change selection rules, disconnect slaves, or stop downloads.
# A recovery message is sent when at least one root exceeds its minimum again.
# !slaves / SITE SLAVES and !df / SITE DF show usable free space:
# sum(max(0, root free space - highest assigned minimum)), keeping total capacity unchanged.
# A slave with zero usable space is labelled FULL. Unconfigured roots contribute raw free space.
# Use multiplier=0 to enforce the reserve; positive multipliers remain scoring-only.
# This reserve does not stop transfers already in progress or reserve their eventual file sizes.
# If a root is an Unraid share, the rule sees that share, not each underlying HDD.
# IRC uses the existing msgslave destination/theme; FTP shows warnings in upload
# replies and SITE SLAVES. Old slaves without this status keep their existing behavior.
# Background checks run every diskstatus.interval seconds (slave.conf, default 30),
# as well as the existing status updates after transfers, deletes, and remerge.

# Simple filter combined w/ the 'assign=all' property.
# The 'assign=all' property saves the admin sometime as it automatically
#  adds the existing roots to the ScoreChart chain.
1.filter=minfreespace
1.minfreespace=5GB
1.assign=all
1.multiplier=1

# If there's a tie on the ScoreChart, Cycle adds a point to the most unused root.
# Should always be last filter on the Chain.
# This filter does not requires a 'assign=' property.
2.filter=cycle

