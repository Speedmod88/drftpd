# Display a stored/cached NFO as 250- comments after entering a confirmed complete release.
# Incomplete and UNKNOWN releases never display NFO text.
enabled=true

# Slave reads are bounded to 64 KiB. FTP output is additionally limited below.
max.lines=200
cache.entries=256
cache.minutes=60

# Persistent master-only store. NFO text is gzip-compressed; no FTP-visible files.
store.enabled=true
store.path=userdata/nfo-display

# Maximum first-entry wait for a cache/store miss; 0 keeps fully asynchronous CWD.
# A slow/offline slave never holds CWD beyond this deadline (allowed: 0..2000).
cwd.wait.millis=500

# Gradually discover NFOs through the index, not a recursive VFS/slave scan.
# Background reads skip transferring/remerging slaves; each file is at most 64 KiB.
# Discovery reads committed index paths: at most 2048 path terms per batch, no full-range sorting.
# Discovery pauses while any slave remerges. Upload/CWD-triggered NFO reads are unchanged.
# The interval is a minimum cooldown AFTER a batch; slow batches automatically wait longer.
prefetch.enabled=true
prefetch.batch=8
prefetch.interval.seconds=2
