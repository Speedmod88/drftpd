#############################
## Auto FreeSpace Settings ##
####################################################################################################

# Smallest number of time in between cycles.
# Times are represented in minutes.
#
# 1440 = 1 day
# 10080 = 1 week
# 43200 = 1 month
#
# Default: [1440]
cycleTime=1440

# Do not delete files with this following names (regex).
#excluded.file.1=.*speedtest.*

# Exclude these slaves from autowipe (space separated).
#excluded.slaves=SLAVE1

# Only announce, no delete.
# Default: [true]
announce.only=true

# Max iterations for any single mode run per slave per cycle
# Default: [5]
max.iterations=5

# On which mode should autofreespace work.
# Possible options: disabled, date, space
# disabled: Do not run date/space cleanup. Sections with dupeonly=true can still run Dupe2 cleanup.
# date: Delete files based on wipeAfter per section
# space: Delete files based on keepFree
# Default: [disabled]
mode=disabled

# AutoFreeSpace will try to keep each slave above this number (Only used if mode = space).
# Default: [100GB]
keepFree=100GB

# Section cleanup rules.
# section accepts one section or comma-separated sections.
# wipeAfter is only used if mode = date.
# dupeonly allows AutoFreeSpace to wipe duplicate variants from this section.
# Dupe2 still scans all sections to decide duplicates and keepers; only dupeonly sections are wiped.
#1.section=SECTION1,SECTION2,SECTION3
#1.wipeAfter=43200
#1.dupeonly=true

####################################################################################################
## Dupe2 duplicate release settings                                                               #
####################################################################################################

# SITE DUPE2 / !dupe2 <release> scans all sections and reports duplicates for the same key.
# SITE DUPE2 / !dupe2 <section> uses that section's dirlisting, deduplicates by Dupe2 key,
# then reports matching duplicate groups found across all sections.
# AutoFreeSpace Dupe2 cleanup also scans all sections, but only wipes from sections with x.dupeonly=true.
# Commands show status=completed or status=incomplete. Cleanup ignores incomplete releases.
# Completion is checked from zipscript SFV/DIZ metadata.

# Remove the trailing release group before parsing/scoring.
# Example: Release.Name.2025.FRENCH.1080p.WEB.H264-GROUP -> Release.Name.2025.FRENCH.1080p.WEB.H264
dupe.group.regex=-([A-Za-z0-9._]+)$

# First token that marks the start of variant details. The duplicate key is everything before this marker.
# Edit this regex to add/remove markers whenever you need new release tags to split the title/key.
# S01E01, E01, and E001 are not markers by default, so they stay in the key and different episodes do not collide.
# Examples:
#   My.Show.S01E01.MULTi.1080p.WEB.x264-GRP -> my.show.s01e01
#   The.Secret.Agent.2025.FRENCH.720p.WEB.H264-GRP -> the.secret.agent.2025
dupe.marker.regex=(?i)(^|[._ -])(MULTI|SUBFRENCH|FRENCH|TRUEFRENCH|VOSTFR|2160P|1080P|720P|480P|WEB[-.]?DL|WEBDL|WEB|BLURAY|BDRIP|HDRIP|DVDRIP|HDTV|UHD|HDR|DV|HEVC|H265|H264|X265|X264)([._ -]|$)

# Keep buckets. Dupe2 keeps the highest scored completed duplicate in each matching bucket.
# Use this to keep separate winners such as one 2160p and one 1080p, or one MULTi and one FRENCH.
# If no keep rules are defined, only the single highest scored duplicate is kept.
# If keep rules are defined:
#   dupe.keep.unmatched=true  -> also keep one highest scored duplicate that matches no keep bucket.
#   dupe.keep.unmatched=false -> releases that match no keep bucket are not protected when a bucketed keeper exists.
# A release is assigned to the first keep bucket it matches, so put more specific rules first.
dupe.keep.unmatched=true
#dupe.keep.1.name=2160p
#dupe.keep.1.regex=(?i)(^|[._ -])2160P([._ -]|$)
#dupe.keep.2.name=1080p
#dupe.keep.2.regex=(?i)(^|[._ -])1080P([._ -]|$)
#dupe.keep.3.name=multi
#dupe.keep.3.regex=(?i)(^|[._ -])MULTI([._ -]|$)
#dupe.keep.4.name=french
#dupe.keep.4.regex=(?i)(^|[._ -])FRENCH([._ -]|$)

# Scoring rules. Add as many as needed. Highest score wins inside each keep bucket.
dupe.score.1.regex=(?i)(^|[._ -])MULTI([._ -]|$)
dupe.score.1.points=200
dupe.score.2.regex=(?i)(^|[._ -])FRENCH([._ -]|$)
dupe.score.2.points=120
dupe.score.3.regex=(?i)(^|[._ -])SUBFRENCH([._ -]|$)
dupe.score.3.points=50
dupe.score.4.regex=(?i)(^|[._ -])2160P([._ -]|$)
dupe.score.4.points=300
dupe.score.5.regex=(?i)(^|[._ -])1080P([._ -]|$)
dupe.score.5.points=200
dupe.score.6.regex=(?i)(^|[._ -])720P([._ -]|$)
dupe.score.6.points=100
